{
  "version": 2,
  "rewrites": [
    {
      "source": "/partnership",
      "destination": "/api/partnership"
    }
  ],
  "headers": [
    {
      "source": "/partnership",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ]
}
